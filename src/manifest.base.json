{
  "manifest_version": 3,
  "name": "Tenebra - Dark Mode for Every Site",
  "short_name": "Tenebra",
  "version": "0.1.0",
  "description": "Fast, minimal dark mode. Per-site control. Zero telemetry, zero network calls.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "activeTab"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["file://*/*"],
      "js": [
        "shared/storage.js",
        "content/heuristics.js",
        "content/site-overrides.js",
        "content/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/dark-theme.css"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
